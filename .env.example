# Xbox Profile Lab — environment configuration
# Copy this file to .env for local development. On Vercel, add production
# values under Project Settings -> Environment Variables. Never commit .env.

# --- Persistent database (required on Vercel) -------------------------------
# Create a Turso/libSQL database, then obtain its URL and database token:
#   turso db create xbox-profile-lab
#   turso db show xbox-profile-lab --url
#   turso db tokens create xbox-profile-lab
# Without TURSO_DATABASE_URL, local development uses ./data/xbox_checker.db.
# Vercel's SQLite fallback is /tmp and is intentionally reported as NOT ready;
# production authentication is rejected with 503 rather than pretending that
# users/sessions will survive between function instances.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=replace-with-the-database-token
# SQLITE_PATH=./data/xbox_checker.db

# --- Microsoft OAuth / Xbox profile (required for the connection feature) ---
# Register a Web application in Microsoft Entra. Add the exact callback URL as
# a Web redirect URI. For production this must be HTTPS and normally is:
#   https://your-domain.example/microsoft/callback
# For local development, http://localhost:8000/microsoft/callback is allowed.
# MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MICROSOFT_CLIENT_SECRET=replace-with-the-entra-client-secret
# MICROSOFT_REDIRECT_URI=http://localhost:8000/microsoft/callback

# --- Application security ---------------------------------------------------
# Generate independent values, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# WATERMARK_SECRET must have at least 32 characters in production. It signs API
# response payloads and is never sent to browser JavaScript.
WATERMARK_SECRET=
ADMIN_API_KEY=

# Opaque browser sessions are stored as SHA-256 digests in the database.
# Allowed range: 300 seconds to 30 days. Default: 604800 (7 days).
SESSION_TTL_SECONDS=604800
# Local default. On production either set true or omit it (Vercel defaults secure).
SESSION_COOKIE_SECURE=false

# Distributed database-backed authentication throttles. Defaults shown:
# 10 login attempts per email/client in 15 minutes, and 8 registration
# attempts per client per hour.
LOGIN_MAX_ATTEMPTS=10
REGISTRATION_MAX_ATTEMPTS=8

# Same-origin browser access needs no CORS configuration. For a separate local
# frontend, provide explicit comma-separated origins; never use "*" with cookies.
# CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Compatibility tier limits ---------------------------------------------
# Retained for developer API account metadata. The retired password-check
# endpoint does not consume these counters.
FREE_DAILY_LIMIT=100
PREMIUM_DAILY_LIMIT=1000
PRO_DAILY_LIMIT=999999

# ---------------------------------------------------------------------------
# Xbox Checker API — environment configuration
# Copy to .env for local development, or set this in Vercel Project Settings
# → Environment Variables for production.
# ---------------------------------------------------------------------------

# --- Security ----------------------------------------------------------------
# Shared secret for HMAC-SHA256 response signing. Set a long random value in
# production so only clients that know the secret can verify signatures.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WATERMARK_SECRET=change-this-to-a-long-random-string

# ---------------------------------------------------------------------------
# Xbox Checker SaaS — environment configuration
# Copy to .env for local development, or set these in Vercel Project Settings
# → Environment Variables for production.
# ---------------------------------------------------------------------------

# --- Database (Turso) -------------------------------------------------------
# Without these the app uses a local SQLite database automatically (great for
# local dev; ephemeral on Vercel serverless). For persistent production data,
# create a free Turso database and set both values.
#   turso db create xbox-checker
#   turso db show xbox-checker --url
#   turso db tokens create xbox-checker
TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional: override the SQLite fallback location (default: ./data/*.db
# locally, /tmp/*.db on Vercel).
# SQLITE_PATH=/tmp/xbox_checker.db

# --- Security (set strong random values in production!) --------------------
WATERMARK_SECRET=change-this-to-a-long-random-string
ADMIN_API_KEY=your-super-secret-admin-key
JWT_SECRET=another-random-secret-for-jwt

# --- Rate limits (checks per user per day, per tier) ------------------------
FREE_DAILY_LIMIT=100
PREMIUM_DAILY_LIMIT=1000
PRO_DAILY_LIMIT=999999
